{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scriptorium Routing Contract",
  "type": "object",
  "required": ["routing_contract_version", "request", "artifacts"],
  "properties": {
    "routing_contract_version": { "type": "integer", "const": 1 },
    "request": {
      "type": "object",
      "required": ["raw", "primary_intent", "requested_artifacts"],
      "properties": {
        "raw": { "type": "string" },
        "command": { "type": ["string", "null"] },
        "primary_intent": {
          "type": "string",
          "enum": [
            "comprehensive_learning",
            "structured_study",
            "rapid_reference",
            "worked_problem_solving",
            "practical_implementation",
            "knowledge_assessment",
            "synthesis_and_revision"
          ]
        },
        "requested_artifacts": { "type": "integer", "minimum": 1 }
      }
    },
    "shared_context": { "type": "boolean" },
    "source_constraints": {
      "type": "object",
      "properties": {
        "source_policy": { "type": "string", "enum": ["independent", "strict", "expanded", "comparative"] },
        "research_mode": { "type": "string", "enum": ["R-S0", "R-S1", "R-S2", "R-I", "R-C", "R-L", "R-R"] },
        "preserve_source_order": { "type": "boolean" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["master", "master_id", "master_path", "legacy_route", "knowledge_types", "modules"],
        "properties": {
          "master": { "type": "string", "enum": ["M1", "M2", "M3", "M4", "M5", "M6", "M7"] },
          "master_id": { "type": "string" },
          "master_path": { "type": "string" },
          "variant": { "type": ["string", "null"] },
          "variant_path": { "type": ["string", "null"] },
          "legacy_route": { "type": "string" },
          "knowledge_types": { "type": "array", "items": { "type": "string" } },
          "modules": { "type": "array", "items": { "type": "string" } },
          "resolution": { "type": "string" }
        }
      }
    },
    "routing_trace": { "type": "object" }
  }
}
